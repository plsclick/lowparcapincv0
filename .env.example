# Copy values into your shell environment or a local, untracked .env file.
# Phase 0 does not load .env files automatically.

LOWP_APP_NAME=LowParLLMCapacityIncV0
LOWP_APP_VERSION=0.1.0
LOWP_OLLAMA_URL=http://127.0.0.1:11434
LOWP_BASE_MODEL=qwen3.5:4b
LOWP_KEEP_ALIVE=5m
LOWP_CONTEXT_SIZE=4096
LOWP_TEMPERATURE=0.7
LOWP_TOP_P=0.8
LOWP_TOP_K=20
LOWP_NUM_PREDICT=-1
LOWP_MAX_HISTORY_MESSAGES=40
# Automatic intent-based local/web research routing is enabled by default.
LOWP_ROUTER_AUTOMATIC=true
# Per-task model and adapter selection are unsupported by the current backend.
LOWP_ROUTER_AUTO_MODEL=false
LOWP_ROUTER_AUTO_ADAPTER=false
# For nontrivial configuration, edit ~/.config/lowp/config.toml instead.
LOWP_LOG_LEVEL=INFO
# Optional SearXNG instance URL. The default is http://127.0.0.1:8080.
SEARXNG_BASE_URL=http://127.0.0.1:8080
